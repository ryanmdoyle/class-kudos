# --- Sessions -----------------------------------------------------------
# Signs the session cookie. Generate with: openssl rand -base64 32
# In `vite dev` rwsdk falls back to a development key if this is unset, but
# production will refuse to start without it.
AUTH_SECRET_KEY=replace-me-with-openssl-rand-base64-32

# --- Supabase (teacher password verification + reset emails ONLY) -------
# Supabase Dashboard -> Project Settings -> API. See SUPABASE_SETUP.md.
# Students NEVER touch Supabase; they log in with a class code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-me-anon-public-key

# !! SERVICE ROLE — bypasses every authorization rule in the Supabase project.
# Used only by `src/auth/provision.ts` (the seed/admin path). Never sent to a
# browser; never prefixed with VITE_.
SUPABASE_SERVICE_ROLE_KEY=replace-me-service-role-key

# --- Supabase Postgres (the app database) -------------------------------
# MUST be the SUPAVISOR POOLER uri, from Dashboard -> Connect -> Transaction
# pooler. Port 6543.
#
# Do NOT use the direct connection (db.<ref>.supabase.co:5432): it is IPv6-only
# and Cloudflare Workers cannot open outbound IPv6 connections. The pooler is
# IPv4 on every tier, so this is a hard requirement, not a preference.
#
# Percent-encode any special characters in the password.
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres

# --- Optional -----------------------------------------------------------
# Absolute public origin. Every confirmation and password-reset link is built
# from it (see getAppOrigin in src/lib/supabase.ts).
#
# LEAVE THIS UNSET LOCALLY. When absent, getAppOrigin falls back to the origin of
# the incoming request, which is what makes the emailed links point at
# http://localhost:5173 during development. Setting it here would send your dev
# signup links to production.
#
# PRODUCTION ONLY, and set as a Cloudflare secret rather than here:
#   npx wrangler secret put APP_URL      ->  https://classkudos.com
#
# It must match the deployed origin EXACTLY (scheme, host, no trailing slash) and
# be on Supabase's redirect allow-list, or Supabase silently substitutes its Site
# URL and the link loses its path.

# Sentry DSN. Leave unset to disable error reporting.
# SENTRY_DSN=https://...ingest.us.sentry.io/...
