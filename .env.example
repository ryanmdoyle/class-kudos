# Template for .dev.vars — the one local env file.
#
#   cp .env.example .dev.vars
#
# Named .env.example because rwsdk's tooling looks for that name; the file the app
# and the tests actually read is .dev.vars. See README "Environments" for why there
# is only one, and why production needs no file at all.
#
# The values below are the local Supabase stack's, and none of them are secret: the
# keys are the Supabase CLI's fixed demo values, identical on every machine, and the
# database password is "postgres". Copy this file and it works as-is — the only line
# worth changing is AUTH_SECRET_KEY.
#
# Bring the stack up with:  npm run test:db

# Signs the session cookie. Generate your own: openssl rand -base64 32
AUTH_SECRET_KEY=replace-me-with-openssl-rand-base64-32

# Local Postgres. The test suite and the dev server both refuse a non-local
# database, so this must stay on 127.0.0.1 unless you set ALLOW_REMOTE_DB=1.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# The local stack's Kong gateway. GoTrue is served behind it at /auth/v1/*, and it
# catches confirmation and reset email at http://127.0.0.1:54324 — which is why you
# never need to point dev at the real project.
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU"

# --- optional, all off by default -------------------------------------------
# APP_URL      leave UNSET locally, or emailed links point at production (trap 6)
# SENTRY_DSN   unset = error reporting off, and the CSP does not widen
# TEST_SERVER=external   make the test suite use YOUR dev server instead of spawning one
