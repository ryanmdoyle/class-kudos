# Node modules
node_modules

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*

# Environment variables
#
# `.dev.vars` is the only local env file this repo uses — the Worker reads it for
# bindings and vitest.config.mts parses it for the test suite. The `.env*` names
# below are not used by anything here; they stay ignored so that a stray one (from
# a tool, a tutorial, or rwsdk's ensure-env on a fresh clone) can never be
# committed with real values in it.
.dev.vars
.env
.env.*
!.env.example

# Vite build output
dist

# TypeScript
*.tsbuildinfo

