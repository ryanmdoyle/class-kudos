{
  // Schema reference for wrangler configuration
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "class-kudos-sdk",
  "main": "src/worker.tsx",

  // rwsdk 1.7 requires 2025-08-21 or later.
  "compatibility_date": "2025-08-21",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "binding": "ASSETS"
  },

  /*
   * Serve the app on the apex domain.
   *
   * `custom_domain: true` makes Cloudflare create and manage the DNS record for
   * classkudos.com and point it at this Worker. It requires the domain to be an
   * active zone in the same Cloudflare account — adding it here does not
   * register or transfer the domain, and `wrangler deploy` fails with a clear
   * error if the zone is missing.
   *
   * This host must stay in step with two other places, or emailed links break:
   *   - the APP_URL secret          (npx wrangler secret put APP_URL)
   *   - Supabase's Site URL and redirect allow-list
   * Every confirmation and reset link is built from APP_URL, so a mismatch sends
   * teachers to a host the app does not answer on.
   *
   * NOTE: www is deliberately NOT routed. Links are always built from APP_URL
   * (the apex), so www never appears in one. If you want www.classkudos.com to
   * resolve for people who type it, add a Cloudflare Redirect Rule sending it to
   * the apex — that is cheaper than a second Worker route and keeps exactly one
   * canonical origin.
   */
  "routes": [
    {
      "pattern": "classkudos.com",
      "custom_domain": true
    }
  ],

  "observability": {
    "enabled": true
  },

  // Sessions are a SQLite-backed Durable Object — small, hot, and worth keeping
  // co-located with the edge rather than a network round trip away.
  //
  // Application data is NOT here any more. It lives in Supabase Postgres,
  // reached over DATABASE_URL via the Supavisor pooler, and its schema is
  // applied with `supabase db push` rather than migrating itself at first use.
  // The `v1` migration tag is retained: Cloudflare migration tags are an
  // append-only history, so the original entry stays and `v2` records the
  // removal of the Database class.
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_DURABLE_OBJECT",
        "class_name": "SessionDurableObject"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Database", "SessionDurableObject"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["Database"]
    }
  ],

  // Non-secret configuration only. The six the Worker cannot run without —
  // AUTH_SECRET_KEY, DATABASE_URL, SUPABASE_URL, SUPABASE_ANON_KEY,
  // SUPABASE_SERVICE_ROLE_KEY, APP_URL — plus the optional SENTRY_DSN live in
  // `.dev.vars` locally and in `wrangler secret put` in production. See
  // SUPABASE_SETUP.md §6, and `npm run check:secrets` to verify production.
  //
  // Do NOT add a `secrets: { required: [...] }` block here: it turns `.dev.vars`
  // into an allow-list, so any key not listed stops reaching the Worker in dev.
  // scripts/check-secrets.mjs explains it at length.
  "vars": {
    "APP_NAME": "Class Kudos"
  }
}
