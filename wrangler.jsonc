{
  // Schema reference for wrangler configuration
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "class-kudos-sdk",
  "main": "src/worker.tsx",

  // rwsdk 1.7 requires 2025-08-21 or later.
  "compatibility_date": "2025-08-21",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Both the application database and the session store are SQLite-backed
  // Durable Objects. There is no D1 database any more: `rwsdk/db` runs its own
  // migrations inside the DATABASE Durable Object at first use (dev-server
  // startup and the first production request), NOT via
  // `wrangler d1 migrations apply`.
  "durable_objects": {
    "bindings": [
      {
        "name": "DATABASE",
        "class_name": "Database"
      },
      {
        "name": "SESSION_DURABLE_OBJECT",
        "class_name": "SessionDurableObject"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Database", "SessionDurableObject"]
    }
  ],

  // Non-secret configuration only. Secrets (AUTH_SECRET_KEY, SUPABASE_URL,
  // SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, SENTRY_DSN) live in
  // `.dev.vars` locally and in `wrangler secret put` in production — see
  // SUPABASE_SETUP.md.
  "vars": {
    "APP_NAME": "Class Kudos"
  }
}
